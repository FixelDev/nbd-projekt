<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="nbd-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>pl.lodz.p.model.db.GuestEnt</class>
        <class>pl.lodz.p.model.db.GuestTypeEnt</class>
        <class>pl.lodz.p.model.db.GuestTypeDefaultEnt</class>
        <class>pl.lodz.p.model.db.GuestTypeExtraEnt</class>
        <class>pl.lodz.p.model.db.GuestTypePremiumEnt</class>
        <class>pl.lodz.p.model.db.RoomEnt</class>
        <class>pl.lodz.p.model.db.RentEnt</class>


        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/nbddb"/>
            <property name="jakarta.persistence.jdbc.user" value="nbd"/>
            <property name="jakarta.persistence.jdbc.password" value="nbdpassword"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>